{
  "manifest_version": 3,
  "name": "Sound Stickers",
  "version": "0.7.2",
  "description": "Create stickers with sound from a video, image, or GIF and send them from WhatsApp Web. Unofficial extension.",
  "icons": {
    "16": "icons/icono-16.png",
    "32": "icons/icono-32.png",
    "48": "icons/icono-48.png",
    "128": "icons/icono-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Create sound sticker",
    "default_icon": {
      "16": "icons/icono-16.png",
      "32": "icons/icono-32.png"
    }
  },
  "options_page": "registro.html",
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/logger.js", "src/convert.js", "src/wa.js", "src/ui.js", "src/main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
